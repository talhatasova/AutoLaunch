{
  "name": "directorylaunch",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "e2e": "pnpm --filter web e2e",
    "typecheck": "pnpm -r typecheck",
    "worker": "pnpm --filter worker dev",
    "validate:seed": "tsx scripts/validate-seed.mts",
    "seed:directories": "tsx --env-file-if-exists=.env scripts/seed-directories.mts"
  },
  "devDependencies": {
    "tsx": "^4.19.2"
  }
}
