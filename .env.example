# ---- Supabase (project ref: pxdldpzbtrdulyqxaegn) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Worker only. NEVER expose to the browser, never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ---- Postgres for pg-boss ----
# MUST be session mode. Port 5432 (direct/session pooler), NOT 6543.
# The transaction pooler breaks pg-boss prepared statements and advisory locks;
# the symptom is jobs that enqueue and never run.
DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# ---- App ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SCRAPER_USER_AGENT=DirectoryLaunchBot/1.0 (+https://directorylaunch.app/bot)

# ---- Worker (apps/worker) ----
WORKER_CONCURRENCY=2
# Minimum gap between requests to the same host. We are a guest on these sites.
RATE_LIMIT_PER_DOMAIN_MS=5000
NAVIGATION_TIMEOUT_MS=30000
HEADLESS=true

# Tier 1 credentials, one per directory, named from the slug:
#   DIRECTORY_API_KEY_<SLUG_IN_UPPER_SNAKE>
# There are no Tier 1 directories in the catalog today. A missing key resolves
# needs_manual rather than failing - nothing is broken, we just cannot submit for you.
# DIRECTORY_API_KEY_SOME_DIRECTORY=
