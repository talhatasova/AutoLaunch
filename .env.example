# ---- Intended Supabase project ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# API and worker only. NEVER expose to the browser or web service.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ---- App ----
NEXT_PUBLIC_MARKETING_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
# Optional server-side Railway private address for the API.
API_INTERNAL_URL=http://localhost:8000
# FastAPI only: copy the public Supabase URL/key above without NEXT_PUBLIC_ prefixes.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here
APP_ORIGIN=http://127.0.0.1:3000
# API -> web internal verification. Use the same random secret in both services.
WEB_INTERNAL_URL=http://localhost:3000
INTERNAL_VERIFY_KEY=replace_with_a_long_random_secret
SCRAPER_USER_AGENT=DirectoryLaunchBot/1.0 (+https://xxx.com/bot)

# ---- Worker (apps/worker) ----
# The worker processes one approved job at a time and pauses five seconds per host.
