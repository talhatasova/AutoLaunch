# ---- Intended Supabase project ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Server-only legacy key (the API and worker use DATABASE_URL). NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your_server_only_secret_key_here

# ---- App ----
NEXT_PUBLIC_MARKETING_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
# Optional server-side Railway private address for the API.
API_INTERNAL_URL=http://localhost:8000
# FastAPI only: copy the public Supabase URL/key above without NEXT_PUBLIC_ prefixes.
# Tokens are verified against ${SUPABASE_URL}/auth/v1/.well-known/jwks.json; the key is
# only used when that is unavailable (legacy HS256 projects).
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here
# FastAPI only: Postgres for app/db (SQLAlchemy + asyncpg). Use the SESSION pooler or the
# direct connection on port 5432, never the transaction pooler on 6543 (it breaks `set local`
# request claims and asyncpg prepared statements). Server-only secret.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
APP_ORIGIN=http://127.0.0.1:3000
SCRAPER_USER_AGENT=DirectoryLaunchBot/1.0 (+https://xxx.com/bot)

# API only: generates launch posts/descriptions. Without it, /launch-text returns 503.
ANTHROPIC_API_KEY=

# ---- Worker (apps/worker) ----
# The worker processes one approved job at a time and pauses five seconds per host.
# DATABASE_URL (above) is the worker's only DB access (Drizzle + postgres-js): session pooler
# or direct connection on port 5432, as a role that bypasses RLS (e.g. postgres).
# AES-256-GCM key shared with the API: base64 of exactly 32 bytes (openssl rand -base64 32).
TOKEN_ENCRYPTION_KEY=
# CAPTCHA solver key (CapSolver). Not read yet: the solver module is pending; challenges resolve needs_manual.
CAPSOLVER_API_KEY=
# Platform Gmail inbox (IMAP + app password). Each submission uses local+<submission_id>@domain.
# Unset: form email fields use public_contact_email; channels needing email verification resolve unconfirmed.
PLATFORM_INBOX_ADDRESS=
PLATFORM_INBOX_APP_PASSWORD=
